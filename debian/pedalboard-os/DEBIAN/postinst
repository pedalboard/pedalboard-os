#!/bin/sh
set -e

PEDALBOARD_USER=pedalboard
PEDALBOARD_GROUP=pedalboard

case "$1" in
    configure)
        # Create dedicated system user and group if they don't exist.
        if ! getent group "$PEDALBOARD_GROUP" > /dev/null 2>&1; then
            addgroup --system "$PEDALBOARD_GROUP"
        fi
        if ! getent passwd "$PEDALBOARD_USER" > /dev/null 2>&1; then
            adduser --system --ingroup "$PEDALBOARD_GROUP" \
                --home /var/lib/pedalboard \
                --no-create-home \
                --shell /usr/sbin/nologin \
                "$PEDALBOARD_USER"
        fi

        # Add pedalboard user to audio group for JACK/ALSA access.
        if getent group audio > /dev/null 2>&1; then
            usermod -aG audio "$PEDALBOARD_USER"
        fi

        # Create runtime data directory.
        install -d -o "$PEDALBOARD_USER" -g "$PEDALBOARD_GROUP" -m 750 \
            /var/lib/pedalboard

        # Substitute pedalboard user into service files.
        for svc in \
            /lib/systemd/system/pedalboard-jack.service \
            /lib/systemd/system/pedalboard-modhost.service \
            /lib/systemd/system/pedalboard-modui.service \
            /lib/systemd/system/pedalboard-bridge.service; do
            if [ -f "$svc" ]; then
                sed -i "s/^User=.*/User=${PEDALBOARD_USER}/" "$svc"
            fi
        done

        # Reload systemd and udev.
        systemctl daemon-reload || true
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=usb || true

        # Enable services (but don't start — let the user do that).
        systemctl enable pedalboard-jack.service || true
        systemctl enable pedalboard-modhost.service || true
        systemctl enable pedalboard-bridge.service || true
        systemctl enable pedalboard-modui.service || true
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# Automatically added by dh_installsystemd/13.11.4
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	# The following line should be removed in trixie or trixie+1
	deb-systemd-helper unmask 'pedalboard-bridge.service' >/dev/null || true

	# was-enabled defaults to true, so new installations run enable.
	if deb-systemd-helper --quiet was-enabled 'pedalboard-bridge.service'; then
		# Enables the unit on first installation, creates new
		# symlinks on upgrades if the unit file has changed.
		deb-systemd-helper enable 'pedalboard-bridge.service' >/dev/null || true
	else
		# Update the statefile to add new symlinks (if any), which need to be
		# cleaned up on purge. Also remove old symlinks.
		deb-systemd-helper update-state 'pedalboard-bridge.service' >/dev/null || true
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.11.4
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	# The following line should be removed in trixie or trixie+1
	deb-systemd-helper unmask 'pedalboard-jack.service' >/dev/null || true

	# was-enabled defaults to true, so new installations run enable.
	if deb-systemd-helper --quiet was-enabled 'pedalboard-jack.service'; then
		# Enables the unit on first installation, creates new
		# symlinks on upgrades if the unit file has changed.
		deb-systemd-helper enable 'pedalboard-jack.service' >/dev/null || true
	else
		# Update the statefile to add new symlinks (if any), which need to be
		# cleaned up on purge. Also remove old symlinks.
		deb-systemd-helper update-state 'pedalboard-jack.service' >/dev/null || true
	fi
