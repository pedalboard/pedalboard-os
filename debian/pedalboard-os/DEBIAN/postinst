# Automatically added by dh_installsystemd/13.11.4
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			_dh_action=restart
		else
			_dh_action=start
		fi
		deb-systemd-invoke $_dh_action 'pedalboard-bridge.service' 'pedalboard-dev.target' 'pedalboard-gig.target' 'pedalboard-jack.service' 'pedalboard-modhost.service' 'pedalboard-modui.service' >/dev/null || true
	fi
fi
