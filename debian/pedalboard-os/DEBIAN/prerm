#!/bin/sh
set -e

SERVICES="pedalboard-modui pedalboard-bridge pedalboard-modhost pedalboard-jack"
TARGETS="pedalboard-gig pedalboard-dev"

case "$1" in
    remove|purge)
        # Stop and disable all services.
        for svc in $SERVICES; do
            systemctl stop "${svc}.service" 2>/dev/null || true
            systemctl disable "${svc}.service" 2>/dev/null || true
        done

        systemctl daemon-reload || true
        ;;

    upgrade|deconfigure|failed-upgrade)
        # On upgrade: stop services so new unit files can be installed cleanly.
        for svc in $SERVICES; do
            systemctl stop "${svc}.service" 2>/dev/null || true
        done
        ;;

    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# Automatically added by dh_installsystemd/13.11.4
if [ -z "${DPKG_ROOT:-}" ] && [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	deb-systemd-invoke stop 'pedalboard-bridge.service' 'pedalboard-dev.target' 'pedalboard-gig.target' 'pedalboard-jack.service' 'pedalboard-modhost.service' 'pedalboard-modui.service' >/dev/null || true
fi
# End automatically added section


exit 0
