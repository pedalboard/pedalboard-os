[Unit]
Description=Pedalboard Gig Mode (minimal audio-only runtime)
Documentation=https://github.com/pedalboard/pedalboard-os/issues/8
Requires=pedalboard-jack.service pedalboard-modhost.service pedalboard-bridge.service
After=pedalboard-jack.service pedalboard-modhost.service pedalboard-bridge.service
AllowIsolate=yes

# Gig mode keeps only audio-critical services running:
#   - pedalboard-jack (JACK audio server)
#   - pedalboard-modhost (LV2 plugin host)
#   - pedalboard-bridge (MIDI + audio switching, listens for mode-exit command)
#   - systemd (watchdog, service supervision)
#   - udev (USB re-enumeration)
#
# Everything else is stopped via isolate (SSH, WiFi, avahi, cron, journald, getty, MOD UI).
