[Unit]
Description=Pedalboard Dev Mode (full stack with networking and debug tools)
Documentation=https://github.com/pedalboard/pedalboard-os/issues/8
Requires=pedalboard-jack.service pedalboard-modhost.service pedalboard-bridge.service
After=pedalboard-jack.service pedalboard-modhost.service pedalboard-bridge.service
Wants=pedalboard-modui.service ssh.service avahi-daemon.service cron.service NetworkManager.service systemd-journald.service getty.target
AllowIsolate=yes

# Dev mode runs the full stack:
#   - All gig mode services (jack, modhost, bridge)
#   - pedalboard-modui (audio plugin editor web UI)
#   - SSH (remote access)
#   - avahi-daemon (mDNS .local discovery)
#   - cron (scheduled tasks)
#   - NetworkManager (WiFi/Ethernet)
#   - journald (full logging)
#   - getty (serial console)
